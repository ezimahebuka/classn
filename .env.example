# Local-only mock credentials. Never use real email account credentials.
DEMO_USERNAME=demo-user
DEMO_PASSWORD=demo-pass-123

# Generate a local key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-local-secret

# Optional. Leave blank to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional; debug mode should remain off outside local development.
FLASK_DEBUG=0
PORT=5000